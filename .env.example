# Express Server API Keys
JWT_SECRET=change_me_in_prod
TMDB_API_KEY=your_tmdb_api_key

# PostgreSQL Database Variables
# DATABASE_URL:
#     - user & password: Your admin login credentials to your psql db
#     - localhost: Service name of the database in your docker-compose
#     - (port) 5432: Port number to connect to the database
#     - cinecritic: Replace for custom name of database
# POSTGRES_DB: Should match the DATABSE_URL database name
# POSTGRES_USER: Should match the DATABSE_URL user
# POSTGRES_PASSWORD: Should match the DATABSE_URL password
DATABASE_URL=postgres://user:password@localhost:5432/cinecritic
POSTGRES_DB=custom_name_for_the_db
POSTGRES_USER=custom_name_of_the_superuser
POSTGRES_PASSWORD=password_for_the_superuser